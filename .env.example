# Supabase Configuration
PUBLIC_SUPABASE_URL=your-supabase-project-url
# Clave secreta (sb_secret_…). Necesaria para reenviar la IP del usuario a Supabase Auth
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Clave secreta del widget de Turnstile "bigibai-enlace-magico". En local no hace falta
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Encryption Secret (mínimo 32 caracteres para AES-256)
# Genera uno seguro con: openssl rand -base64 32
ENCRYPTION_SECRET=your-very-long-and-secure-secret-key-here-minimum-32-chars
SALT_KEY=your-salt-key

# Secreto del HMAC de los cupones (mínimo 32 caracteres). No está en la base de datos:
# si se pierde hay que volver a importar los cupones. Genera uno con: openssl rand -hex 32
COUPON_HMAC_SECRET=your-coupon-hmac-secret-minimum-32-chars

# Admin (IDs de usuario separados por comas)
ADMIN_USERS_IDS=user-id-1,user-id-2
TOTAL_COUPONS=0

# Campaña (fechas en src/data/campaign.ts)
# Pon "false" para apagar las casillas y los juegos al terminar la campaña
EXPERIENCE_ENABLED=true
