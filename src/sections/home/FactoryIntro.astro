---
import Button from '@/components/Button.astro'
import FactoryLogo from '@/components/ui/FactoryLogo.astro'
import ChocolateBox from '@/components/ChocolateBox.astro'
import { CAMPAIGN } from '@/data/campaign'
interface Props {
  campaignCopy: { title: string; lead?: string; text: string; href: string; cta: string; note: string }
  calendarProgress: { value: number; label: string } | null
  highlights: readonly { value: number; label: string; icon: 'chocolate' | 'gift' | 'door' }[]
}
const { campaignCopy, calendarProgress, highlights } = Astro.props
---

<section class="factory-hero site-container site-container--wide" aria-labelledby="factory-title">
  <div class="hero-copy">
    <h1 id="factory-title">
      <FactoryLogo />
    </h1>
    <p class="hero-headline">{campaignCopy.title}</p>
    <p class="hero-description">
      {campaignCopy.lead && <strong>{campaignCopy.lead}</strong>} {campaignCopy.text}
    </p>
    <div class="hero-actions">
      <Button size="lg" href={campaignCopy.href}>
        {campaignCopy.cta}
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </Button>
    </div>
    <div class="hero-details">
      {calendarProgress && (
        <p class="hero-progress">
          <strong>{calendarProgress.value}</strong>
          <span>{calendarProgress.label}</span>
        </p>
      )}
      <p class="hero-note">{campaignCopy.note}</p>
    </div>
  </div>
  <div class="hero-art">
    <ChocolateBox />
    <div class="edition-stamp">
      <span>Nueva edición</span>
      <strong>2026</strong>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="m12 0 2.7 9.3L24 12l-9.3 2.7L12 24l-2.7-9.3L0 12l9.3-2.7Z" />
      </svg>
    </div>
  </div>
</section>

<ul class="factory-strip" aria-label={`Big Ibai ${CAMPAIGN.year} en cifras`}>
  {highlights.map(({ value, label, icon }, index) => (
    <li style={`--float-delay: ${index * -1.1}s`}>
      <span class="strip-icon" aria-hidden="true">
        {icon === 'chocolate' && (
          <svg viewBox="0 0 48 48">
            <g transform="rotate(-18 24 24)">
              <rect x="13" y="3" width="22" height="42" rx="3.5" fill="#4a2410" />
              <rect x="14.5" y="4.5" width="19" height="39" rx="2.5" fill="#7b3f1d" />
              <rect x="16.5" y="6.5" width="6.5" height="6" rx="1.2" fill="#9a5528" />
              <rect x="25" y="6.5" width="6.5" height="6" rx="1.2" fill="#9a5528" />
              <rect x="16.5" y="14.5" width="6.5" height="6" rx="1.2" fill="#9a5528" />
              <rect x="25" y="14.5" width="6.5" height="6" rx="1.2" fill="#9a5528" />
              <path d="M17 7.5h5M25.5 7.5h5M17 15.5h5M25.5 15.5h5" stroke="#c07a45" stroke-linecap="round" />
              <path
                d="M13 25l3 -2.5 3 2.5 3 -2.5 3 2.5 3 -2.5 3 2.5 3 -2.5 2 1.7V41.5a3.5 3.5 0 0 1 -3.5 3.5h-15a3.5 3.5 0 0 1 -3.5 -3.5Z"
                fill="var(--brand-accent)"
              />
              <path d="M13 31h22v6H13Z" fill="var(--brand-edge)" opacity=".55" />
              <path d="M16.5 27.5v14" stroke="#ffe3a6" stroke-width="1.6" stroke-linecap="round" />
            </g>
          </svg>
        )}
        {icon === 'gift' && (
          <svg viewBox="0 0 48 48">
            <g transform="rotate(8 24 26)">
              <rect x="10" y="21" width="28" height="22" rx="2.5" fill="#d9443f" />
              <rect x="27" y="21" width="11" height="22" rx="2.5" fill="#b23431" />
              <rect x="7" y="15" width="34" height="8" rx="2" fill="#ef5e57" />
              <rect x="21.5" y="15" width="5" height="28" fill="var(--brand-accent)" />
              <rect x="21.5" y="23" width="5" height="2" fill="var(--brand-edge)" />
              <path
                d="M24 15c-3-7-11-9-12-4s7 5 12 4Zm0 0c3-7 11-9 12-4s-7 5-12 4Z"
                fill="var(--brand-accent)"
                stroke="var(--brand-edge)"
                stroke-width="1.2"
                stroke-linejoin="round"
              />
              <circle cx="24" cy="15" r="2.6" fill="#ffc65c" stroke="var(--brand-edge)" stroke-width="1.2" />
            </g>
          </svg>
        )}
        {icon === 'door' && (
          <svg viewBox="0 0 48 48">
            <defs>
              <radialGradient id="strip-door-glow" cx=".42" cy=".45" r=".7">
                <stop offset="0" stop-color="#fff4d6" />
                <stop offset=".45" stop-color="#ffc65c" />
                <stop offset="1" stop-color="var(--brand-edge)" />
              </radialGradient>
            </defs>
            <rect x="5" y="6" width="28" height="36" rx="4" fill="#1b3768" stroke="var(--brand-accent)" stroke-width="1.6" />
            <rect x="8.5" y="9.5" width="21" height="29" rx="2" fill="url(#strip-door-glow)" />
            <path d="M18 15.5l1.7 5.3 5.3 1.7-5.3 1.7-1.7 5.3-1.7-5.3-5.3-1.7 5.3-1.7Z" fill="#fff" />
            <path d="M29.5 9.5L43 5.5v37l-13.5-4Z" fill="#24467f" stroke="var(--brand-accent)" stroke-width="1.6" stroke-linejoin="round" />
            <circle cx="39.5" cy="24" r="1.6" fill="var(--brand-accent)" />
          </svg>
        )}
      </span>
      <span class="strip-text"><strong>{value}</strong> {label}</span>
    </li>
  ))}
</ul>

<style>
  .factory-hero {
    overflow-x: clip;
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    align-items: center;
    gap: 25px;
    width: min(var(--content-wide), calc(100% - var(--page-gutter) * 2));
    min-height: 690px;
    margin: auto;
    padding: 44px 0 68px;
  }
  .hero-copy {
    position: relative;
    z-index: 2;
  }
  h1 {
    width: min(100%, 570px);
    margin: 0 0 30px;
  }
  .hero-headline {
    color: var(--text-heading);
    max-width: 480px;
    font-size: clamp(21px, 2.05vw, 28px);
    font-weight: bold;
    line-height: 1.35;
    text-wrap: balance;
  }
  .hero-description {
    max-width: 420px;
    margin-top: 16px;
    color: var(--text-copy);
    font-size: 15px;
    line-height: 1.8;
    text-wrap: pretty;
  }
  .hero-actions {
    display: flex;
    align-items: center;
    margin-top: 28px;
  }
  .hero-details {
    display: flex;
    align-items: center;
    gap: 22px;
    margin-top: 33px;
    padding-top: 22px;
    border-top: 1px solid color-mix(in srgb, var(--text-heading) 12.55%, transparent);
    width: fit-content;
    color: var(--text-copy);
    font-size: 14px;
    line-height: 1.55;
    text-align: left;
  }
  .hero-details > * + * {
    border-left: 1px solid color-mix(in srgb, var(--text-heading) 14.9%, transparent);
    padding-left: 24px;
  }
  .hero-progress {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .hero-progress strong {
    color: var(--brand-accent);
    font-size: 44px;
    line-height: 1;
  }
  .hero-progress span {
    max-width: 150px;
  }
  .hero-note {
    max-width: 260px;
    text-wrap: balance;
  }
  .hero-art {
    position: relative;
    align-self: center;
    display: flex;
    justify-content: center;
    padding: 3px 0 0 24px;
  }
  .edition-stamp {
    position: absolute;
    z-index: 2;
    pointer-events: none;
    right: 0;
    bottom: 30px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 116px;
    height: 116px;
    border-radius: 50%;
    border: 1px solid #ffcf71;
    background: var(--brand-accent);
    color: var(--brand-ink);
    transform: rotate(10deg);
    box-shadow: 0 8px 25px #0005;
    transition:
      transform 450ms ease,
      width 450ms ease,
      height 450ms ease;
  }
  .hero-art:has(chocolate-box[data-open='true']) .edition-stamp {
    transform: translateY(40px) rotate(10deg) scale(0.85);
  }
  .edition-stamp span {
    font-size: 10px;
    font-weight: bold;
  }
  .edition-stamp strong {
    font-family: var(--font-display);
    font-weight: normal;
    font-size: 36px;
    line-height: 1.3;
  }
  .edition-stamp svg {
    margin-top: 2px;
  }
  .factory-strip {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(28px, 4vw, 56px);
    width: 100%;
    padding: 20px var(--page-gutter);
    border-block: 1px solid color-mix(in srgb, var(--brand-accent) 31.37%, transparent);
    background: color-mix(in srgb, var(--surface-inset) 46.67%, transparent);
    white-space: nowrap;
  }
  .factory-strip li {
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--text-heading);
    font-family: var(--font-display);
    font-size: 26px;
    line-height: 1;
  }
  .factory-strip li + li::before {
    content: '✦';
    margin-right: clamp(14px, 2vw, 42px);
    color: var(--brand-accent);
    font-family: sans-serif;
    font-size: 14px;
  }
  .factory-strip strong {
    color: var(--brand-accent);
    font-weight: normal;
  }
  .strip-icon {
    position: relative;
    flex-shrink: 0;
    width: 58px;
    height: 58px;
  }
  .strip-icon svg {
    position: relative;
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 6px 8px #0006);
    animation: strip-float 3.4s ease-in-out infinite var(--float-delay);
  }
  .strip-icon::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -6px;
    width: 30px;
    height: 6px;
    margin-left: -15px;
    border-radius: 50%;
    background: #0008;
    filter: blur(3px);
    animation: strip-shadow 3.4s ease-in-out infinite var(--float-delay);
  }
  @keyframes strip-float {
    0%,
    100% {
      transform: translateY(2px) rotate(-4deg);
    }
    50% {
      transform: translateY(-6px) rotate(4deg);
    }
  }
  @keyframes strip-shadow {
    0%,
    100% {
      transform: scaleX(1);
      opacity: 0.9;
    }
    50% {
      transform: scaleX(0.65);
      opacity: 0.45;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .strip-icon svg,
    .strip-icon::after {
      animation: none;
    }
  }
  @media (min-width: 1500px) {
    .factory-hero {
      padding-block: 55px 78px;
      min-height: 750px;
    }
  }
  @media (max-width: 1050px) {
    .factory-hero {
      width: calc(100% - var(--page-gutter) * 2);
    }
    .factory-hero {
      min-height: 615px;
      gap: 15px;
    }
    .hero-art {
      padding-left: 15px;
    }
    .hero-headline {
      font-size: 22px;
    }
    .hero-description {
      font-size: 13px;
    }
    .hero-details {
      gap: 18px;
      font-size: 13px;
    }
    .hero-details > * + * {
      padding-left: 18px;
    }
    .edition-stamp {
      width: 96px;
      height: 96px;
    }
    .edition-stamp strong {
      font-size: 30px;
    }
    .edition-stamp span {
      font-size: 9px;
    }
    .factory-strip li {
      gap: 10px;
      font-size: 20px;
    }
    .strip-icon {
      width: 44px;
      height: 44px;
    }
  }
  @media (max-width: 760px) {
    .factory-hero {
      grid-template-columns: 1fr;
      width: calc(100% - var(--page-gutter) * 2);
      gap: 34px;
      padding-block: 35px 40px;
    }
    .hero-copy {
      text-align: center;
    }
    h1 {
      width: min(100%, 490px);
      margin: 0 auto 24px;
    }
    .hero-headline {
      margin-inline: auto;
      font-size: 23px;
    }
    .hero-description {
      max-width: 420px;
      margin-inline: auto;
      margin-top: 13px;
      font-size: 13px;
      line-height: 1.85;
    }
    .hero-actions {
      justify-content: center;
      margin-top: 23px;
    }
    .hero-details {
      margin: 24px auto 0;
      gap: 14px;
      padding-top: 17px;
    }
    .hero-details > * + * {
      padding-left: 14px;
    }
    .hero-details {
      font-size: 12px;
    }
    .hero-progress {
      flex-shrink: 0;
    }
    .hero-progress span {
      max-width: 118px;
    }
    .hero-progress strong {
      font-size: 36px;
    }
    .hero-art {
      width: min(100%, 440px);
      padding: 0 20px;
      justify-self: center;
    }
    .edition-stamp {
      right: 12px;
      bottom: 25px;
      width: 91px;
      height: 91px;
    }
    .edition-stamp span {
      font-size: 8px;
    }
    .edition-stamp strong {
      font-size: 30px;
    }
    .edition-stamp svg {
      width: 14px;
      height: 14px;
    }
    .hero-art:has(chocolate-box[data-open='true']) .edition-stamp {
      width: 70px;
      height: 70px;
      bottom: 15px;
      right: 12px;
      transform: rotate(10deg);
    }
    .hero-art:has(chocolate-box[data-open='true']) .edition-stamp strong {
      font-size: 24px;
    }
    .hero-art:has(chocolate-box[data-open='true']) .edition-stamp span {
      font-size: 7px;
    }
    .factory-strip {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px 16px;
      padding-block: 16px;
    }
    .factory-strip li {
      justify-content: center;
      gap: 10px;
      font-size: 17px;
    }
    .factory-strip li:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
    .factory-strip li + li::before {
      display: none;
    }
    .strip-icon {
      width: 38px;
      height: 38px;
    }
    .strip-icon::after {
      width: 22px;
      margin-left: -11px;
    }
  }
  @media (max-width: 370px) {
    .hero-details {
      gap: 12px;
      font-size: 11px;
    }
    .hero-details > * + * {
      padding-left: 12px;
    }
  }
</style>
