---
import Container from '@/components/ui/Container.astro'
import SectionHeading from '@/components/ui/SectionHeading.astro'
import Notice from '@/components/ui/Notice.astro'
import Clicker from '@/components/Clicker.astro'
import AchievementsBox from '@/components/AchievementsBox.astro'
import { NOTICES } from '@/data/campaign'
interface Props {
  isLoggedIn: boolean
  userAchievements: Record<string, { created_at: string }>
}
const { isLoggedIn, userAchievements } = Astro.props
---

<Container as="section" id="clicker" class="arcade-section" aria-labelledby="arcade-title">
  <SectionHeading as="h2" id="arcade-title" title="Entra en modo juego." class="arcade-heading" />
  <div class="arcade-content">
    <div class="arcade-game">
      <Clicker />
    </div>
    <div class="arcade-side">
      <AchievementsBox layout="shelf" {isLoggedIn} userAchievements={userAchievements} />
      <Notice class="arcade-notice">{NOTICES.gamesAreOptional}</Notice>
    </div>
  </div>
</Container>

<style>
  .arcade-section {
    margin-inline: auto;
    padding: 0 0 65px;
    scroll-margin-top: 30px;
  }
  .arcade-section :global(.arcade-heading) {
    margin-bottom: 40px;
  }
  .arcade-content {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    align-items: center;
    gap: 40px clamp(40px, 6vw, 88px);
  }
  .arcade-game {
    display: flex;
    justify-content: center;
    min-width: 0;
  }
  .arcade-game :global(#choco-game-container) {
    --bg-color: #0c2258;
    --ui-color: #304878;
    --ui-border: #7290c2;
    --accent-gold: var(--brand-accent);
    max-width: 100%;
    margin: 0;
    border: 2px solid #7290c2;
    border-radius: var(--radius-panel);
    box-shadow:
      0 0 0 6px color-mix(in srgb, var(--surface-inset) 80%, transparent),
      0 0 0 7px var(--border-subtle),
      0 30px 80px -20px #01081d;
    overflow: hidden;
  }
  .arcade-game :global(#choco-start-screen) {
    background: radial-gradient(circle at 50% 30%, #253d7c, #0b1d49);
  }
  .arcade-game :global(.start-btn) {
    background: var(--brand-accent);
    color: var(--brand-ink);
    border-color: #ffd786;
    box-shadow: 0 5px 0 var(--brand-edge);
  }
  .arcade-game :global(.start-btn:hover) {
    background: var(--brand-hover);
    box-shadow: 0 5px 0 var(--brand-edge);
  }
  .arcade-side {
    display: flex;
    flex-direction: column;
    gap: 44px;
    min-width: 0;
  }
  .arcade-side :global(.achievements-box) {
    --achievements-columns: repeat(3, minmax(0, 1fr));
  }
  .arcade-side :global(.arcade-notice) {
    align-items: start;
    padding: 0;
    border: 0;
    background: none;
    color: var(--text-muted);
    font-size: 13px;
    line-height: 1.7;
  }
  @media (max-width: 1050px) {
    .arcade-section {
      width: calc(100% - var(--page-gutter) * 2);
    }
  }
  @media (max-width: 860px) {
    .arcade-content {
      grid-template-columns: 1fr;
    }
    .arcade-side {
      gap: 32px;
    }
  }
  @media (max-width: 760px) {
    .arcade-section {
      padding-bottom: 45px;
    }
    .arcade-section :global(.arcade-heading) {
      margin-bottom: 25px;
    }
    .arcade-game :global(#choco-game-container) {
      box-shadow: 0 20px 50px -20px #01081d;
    }
  }
</style>
