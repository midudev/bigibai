---
import Avatar from '@/components/Avatar.astro'
import Button from '@/components/Button.astro'
import BrandLogo from '@/components/ui/BrandLogo.astro'
import { CAMPAIGN } from '@/data/campaign'
import { supabaseAdmin } from '@/supabase-admin'
import { isAdmin } from '@/utils/admin'

interface Props {
  participationCount?: number
}
let { participationCount } = Astro.props
const user = Astro.locals.user
const home = Astro.url.pathname === '/'
const registration = Astro.url.pathname === '/registro'
const rawName =
  user?.user_metadata?.full_name ?? user?.user_metadata?.name ?? user?.email ?? 'Mi cuenta'
const displayName = typeof rawName === 'string' && rawName.trim() ? rawName : 'Mi cuenta'
const avatar = user?.user_metadata?.avatar_url ?? user?.user_metadata?.picture
if (user && participationCount === undefined) {
  const { count } = await supabaseAdmin
    .from('coupons')
    .select('id', { count: 'exact', head: true })
    .eq('used_by', user.id)
    .eq('is_used', true)
  participationCount = count ?? 0
}
const links = [
  { id: 'calendario', label: 'El calendario' },
  { id: 'como-participar', label: 'Cómo participar' },
  { id: 'llaveros', label: 'Los llaveros' },
  { id: 'tiendas', label: 'Dónde encontrarlo' },
]
---

<header class="site-header site-container site-container--wide">
  <a href="/" class="brand-link" aria-label="Big Ibai, inicio">
    <BrandLogo />
    <span class="brand-year">{CAMPAIGN.year}</span>
  </a>
  <nav class="site-nav" aria-label="Navegación principal">
    {links.map(({ id, label }) => (
      <a href={`${home ? '' : '/'}#${id}`}>{label}</a>
    ))}
  </nav>
  <div class="header-account">
    {user ? (
      <details class="account-menu">
        <summary>
          <Avatar
            src={avatar}
            alt={displayName}
            fallback={displayName.charAt(0).toUpperCase()}
            size="sm"
          />
          <span>Mi cuenta</span>
          <span id="header-participation-count" class="account-count">
            {participationCount ?? 0}
          </span>
        </summary>
        <div class="account-dropdown">
          <p>{displayName}</p>
          <a href="/dashboard">Mis participaciones</a>
          {isAdmin(user.id) && <a href="/admin">Administración</a>}
          <form action="/api/auth/signout" method="post" data-astro-reload>
            <button id="header-logout-btn" type="submit">
              Cerrar sesión
            </button>
          </form>
        </div>
      </details>
    ) : (CAMPAIGN.signInEnabled || registration) && (
      <Button
        id="header-login-btn"
        href={registration ? '/' : '/registro'}
        variant="outline"
        size="sm"
      >
        {registration ? 'Volver al inicio' : 'Iniciar sesión'}
      </Button>
    )}
  </div>
</header>
<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
    padding-block: 27px;
    border-bottom: 1px solid var(--border-subtle);
  }
  .brand-link {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }
  /* Pegatina con el año, a juego con el sello "Nueva edición" del hero */
  .brand-year {
    padding: 4px 7px 2px;
    border-radius: 6px;
    background: var(--brand-accent);
    color: var(--brand-ink);
    font-family: var(--font-display);
    font-size: 15px;
    line-height: 1.15;
    box-shadow: 0 2px 0 var(--brand-edge);
    transform: rotate(-6deg);
  }
  .site-nav {
    display: flex;
    align-items: center;
    gap: clamp(16px, 2.5vw, 34px);
  }
  .site-nav a {
    color: var(--text-heading);
    font-size: 13px;
    white-space: nowrap;
  }
  .site-nav a:hover {
    color: var(--brand-accent);
  }
  .header-account {
    flex-shrink: 0;
  }
  .account-menu {
    position: relative;
  }
  .account-menu summary {
    display: flex;
    align-items: center;
    gap: 9px;
    min-height: 42px;
    color: var(--text-heading);
    font-size: 12px;
    cursor: pointer;
    list-style: none;
  }
  .account-menu summary::-webkit-details-marker {
    display: none;
  }
  .account-count {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    min-width: 23px;
    height: 23px;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    color: var(--brand-accent);
    font-size: 10px;
  }
  .account-dropdown {
    position: absolute;
    right: 0;
    top: calc(100% + 12px);
    z-index: 100;
    width: 230px;
    max-width: 80vw;
    padding: 12px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-control);
    background: var(--surface);
    box-shadow: 0 12px 25px #0003;
  }
  .account-dropdown > p {
    padding: 8px 10px 14px;
    color: var(--text-muted);
    font-size: 11px;
    border-bottom: 1px solid var(--border-subtle);
    overflow-wrap: anywhere;
  }
  .account-dropdown a,
  .account-dropdown button {
    display: block;
    width: 100%;
    padding: 12px 10px;
    border-radius: 6px;
    text-align: left;
    font-size: 12px;
    color: var(--text-heading);
    cursor: pointer;
  }
  .account-dropdown a:hover,
  .account-dropdown button:hover {
    background: var(--surface-raised);
    color: var(--brand-accent);
  }
  @media (max-width: 1050px) {
    .site-header {
      gap: 18px;
    }
    .site-nav {
      gap: 18px;
    }
    .brand-year {
      display: none;
    }
  }
  @media (max-width: 760px) {
    .site-header {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 22px;
      padding-block: 22px 17px;
    }
    .brand-link :global(img) {
      width: 115px !important;
    }
    .brand-year {
      display: block;
    }
    .header-account {
      grid-row: 1;
      grid-column: 2;
    }
    .site-nav {
      grid-column: 1/-1;
      grid-row: 2;
      justify-content: space-between;
      gap: 12px;
    }
    .site-nav a {
      font-size: 10px;
    }
    .account-menu summary {
      font-size: 11px;
    }
  }
  @media (max-width: 370px) {
    .brand-year {
      display: none;
    }
    .site-nav a {
      font-size: 9px;
    }
  }
</style>
