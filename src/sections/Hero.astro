---
import Calendar from './Calendar.astro'
import Container from '@/components/ui/Container.astro'
import FactoryIntro from './home/FactoryIntro.astro'
import Participation from './home/Participation.astro'
import Keychains from './home/Keychains.astro'
import StoreLocator from './home/StoreLocator.astro'
import { CAMPAIGN } from '@/data/campaign'
import {
  getCampaignPhase,
  getCampaignDay,
  getDaysUntilUnlock,
  isExperienceEnabled,
  formatCampaignDate,
} from '@/utils/campaign'
interface Props {
  isLoggedIn: boolean
  participationCount: number
}

const { isLoggedIn, participationCount } = Astro.props
const { now } = Astro.locals
const phase = getCampaignPhase(now)
const currentDay = getCampaignDay(now)
const daysUntilFirstDoor = getDaysUntilUnlock(1, now)

// Lo siguiente que va a pasar en el calendario: la cuenta atrás o las casillas ya abiertas
const calendarProgress = !isExperienceEnabled(now)
  ? null
  : currentDay === 0
    ? {
        value: daysUntilFirstDoor,
        label: `${daysUntilFirstDoor === 1 ? 'día' : 'días'} para abrir la primera casilla`,
      }
    : { value: currentDay, label: `de ${CAMPAIGN.totalDays} casillas abiertas` }
const participations =
  participationCount === 1 ? '1 participación' : `${participationCount} participaciones`

const campaignCopy = {
  upcoming: {
    title: 'La ilusión se fabrica a lo grande.',
    text: 'Vuelve Ibai con un nuevo universo, 24 chocolatinas y muchas ganas de que llegue diciembre.',
    href: '#calendario',
    cta: 'Descubre el calendario',
    note: 'Muy pronto anunciaremos la apertura del registro.',
  },
  registration: {
    title: 'Tu calendario. Tu código. Tu ilusión.',
    text: isLoggedIn
      ? `Tienes ${participations}. Registra el código de tu calendario y prepárate para descubrir una casilla cada día.`
      : '¿Ya tienes tu calendario? Inicia sesión y registra tu código para participar en los sorteos de esta edición.',
    href: isLoggedIn ? '/dashboard' : '/registro',
    cta: isLoggedIn ? 'Registrar mi código' : 'Iniciar sesión y participar',
    note: CAMPAIGN.registrationClosesAt
      ? `Registra tu calendario hasta el ${formatCampaignDate(CAMPAIGN.registrationClosesAt)}.`
      : 'Consulta las condiciones de participación en las bases legales.',
  },
  closed: {
    title: 'Gracias por formar parte de la fábrica.',
    text: 'El plazo para registrar códigos ha terminado. Muy pronto podrás consultar aquí los ganadores de esta edición.',
    href: isLoggedIn ? '/dashboard' : '/registro',
    cta: 'Ver mis participaciones',
    note: 'Los ganadores se publicarán según las bases legales.',
  },
  winners: {
    title: 'La ilusión ya tiene ganadores.',
    text: 'Descubre quiénes se llevan los premios de esta edición de Big Ibai. ¡Gracias por acompañarnos un diciembre más!',
    href: '/ganadores',
    cta: 'Ver los ganadores',
    note: 'Consulta los resultados y las condiciones en las bases legales.',
  },
}[phase]

// Cifras de la franja bajo el hero. Los premios deben coincidir con las bases legales de la edición
const highlights = [
  { value: CAMPAIGN.totalDays, label: 'chocolatinas', icon: 'chocolate' },
  { value: CAMPAIGN.totalDays, label: 'premios', icon: 'gift' },
  { value: 1, label: 'casilla nueva cada día', icon: 'door' },
] as const
---

<FactoryIntro {campaignCopy} {calendarProgress} {highlights} />
<Participation {isLoggedIn} />
<Container class="calendar-wrap">
  <Calendar />
</Container>
<Keychains />
<StoreLocator />

<style>
  .calendar-wrap {
    padding-block: 90px;
  }
  @media (max-width: 760px) {
    .calendar-wrap {
      padding-block: 55px;
    }
  }
</style>
