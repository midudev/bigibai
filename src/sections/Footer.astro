---
import { CAMPAIGN } from '@/data/campaign'
import BrandLogo from '@/components/ui/BrandLogo.astro'
---

<footer class="campaign-footer">
  <div class="footer-main">
    <a href="/" aria-label="Big Ibai, inicio">
      <BrandLogo variant="factory" width={170} />
    </a>
    <nav aria-label="Enlaces legales">
      <a href="/privacidad">Privacidad</a>
      <a href="/aviso-legal">Aviso legal</a>
      <a href="/bases-legales">Bases legales</a>
      <a href="/politica-de-cookies">Política de cookies</a>
    </nav>
    <a class="contact" href="mailto:hola@bigibai.com">
      hola@bigibai.com
    </a>
  </div>
  <div class="footer-bottom">
    <small>© {CAMPAIGN.year} Salad Brands SL. Todos los derechos reservados.</small>
    <span>La ilusión se hace a lo grande.</span>
  </div>
</footer>

<style>
  .campaign-footer {
    position: relative;
    padding: 48px max(var(--page-gutter), calc((100% - var(--content-max)) / 2)) 24px;
    background: var(--surface-inset);
    color: var(--text-copy);
    font-family: var(--font-body);
  }
  .footer-main {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 36px;
    padding-bottom: 34px;
  }
  .footer-main img {
    width: 170px;
    height: auto;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 24px;
    font-size: 11px;
  }
  a:hover {
    color: var(--brand-accent);
  }
  .contact {
    font-size: 12px;
    color: var(--brand-accent);
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    border-top: 1px solid color-mix(in srgb, var(--text-heading) 10.2%, transparent);
    padding-top: 23px;
    font-size: 10px;
  }
  small {
    font-size: inherit;
  }
  @media (max-width: 760px) {
    .campaign-footer {
      padding-top: 38px;
    }
    .footer-main {
      flex-direction: column;
      gap: 27px;
    }
    nav {
      gap: 16px;
      font-size: 10px;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 10px;
    }
  }
</style>
