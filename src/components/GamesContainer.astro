---
import Surface from '@/components/ui/Surface.astro'
import SectionHeading from '@/components/ui/SectionHeading.astro'
import CalendarDoor from '@/components/ui/CalendarDoor.astro'
import Notice from '@/components/ui/Notice.astro'
import { NOTICES } from '@/data/campaign'
import { getCampaignDay, isExperienceEnabled } from '@/utils/campaign'
interface Props {
  totalCoupons: number
}
const { totalCoupons } = Astro.props
const { now } = Astro.locals
const availableDays = isExperienceEnabled(now) ? getCampaignDay(now) : 0
const days = Array.from({ length: availableDays }, (_, i) => i + 1)
---

{availableDays > 0 && (
  <Surface as="section" padded aria-labelledby="available-games">
    <SectionHeading
      as="h2"
      size="card"
      id="available-games"
      title="Tu próxima casilla"
      description={
        totalCoupons > 0
          ? 'Elige un día y descubre el reto que te espera.'
          : 'Necesitas registrar al menos un calendario para acceder a los juegos.'
      }
    />
    <div class="games-grid">
      {days.map((day) => (
        <CalendarDoor day={day} active={true} caption="Jugar" />
      ))}
    </div>
    <Notice>{NOTICES.gamesAreOptional}</Notice>
  </Surface>
)}
<style>
  .games-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(88px, 1fr));
    gap: 10px;
    margin-block: 28px 24px;
  }
  .games-grid :global(.advent-door) {
    min-height: 0;
    aspect-ratio: 1;
  }
  .games-grid :global(.door-number) {
    font-size: 30px;
  }
</style>
