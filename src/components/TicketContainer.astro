---
import { CAMPAIGN } from '@/data/campaign'
interface Props {
  totalCoupons: number
}
const { totalCoupons } = Astro.props
---

<div class="ticket">
  <p class="ticket-body" aria-live="polite">
    <strong id="ticket-coupon-count">{totalCoupons}</strong>
    <span id="ticket-coupon-text">
      {totalCoupons === 1 ? 'participación' : 'participaciones'}
    </span>
  </p>
  <span class="ticket-stub" aria-hidden="true">
    <span>{CAMPAIGN.name}</span>
  </span>
</div>
<style>
  .ticket {
    --notch: 12px;
    display: flex;
    flex-shrink: 0;
    min-width: 280px;
    border-radius: 14px;
    background:
      url('/gold-texture.webp') center / cover,
      var(--brand-accent);
    color: var(--brand-ink);
    mask:
      radial-gradient(circle at 0 50%, #0000 var(--notch), #000 calc(var(--notch) + 0.5px)) left /
        51% 100% no-repeat,
      radial-gradient(circle at 100% 50%, #0000 var(--notch), #000 calc(var(--notch) + 0.5px))
        right / 51% 100% no-repeat;
    rotate: -3deg;
  }
  .ticket-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 2px;
    padding: 22px 28px 20px 32px;
    font-size: 14px;
    font-weight: bold;
  }
  strong {
    font-family: var(--font-display);
    font-size: 96px;
    font-weight: normal;
    line-height: 0.8;
    margin-bottom: -0.14em;
  }
  .ticket-stub {
    display: flex;
    align-items: center;
    justify-content: center;
    padding-inline: 14px 24px;
    border-left: 2px dashed color-mix(in srgb, var(--brand-ink) 35%, transparent);
  }
  .ticket-stub span {
    writing-mode: vertical-rl;
    rotate: 180deg;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.7;
  }
  @media (max-width: 760px) {
    .ticket {
      min-width: 0;
      width: min(100%, 300px);
      rotate: -2deg;
    }
    strong {
      font-size: 76px;
    }
  }
</style>
