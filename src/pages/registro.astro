---
import PageLayout from '@/layouts/PageLayout.astro'
import SectionHeading from '@/components/ui/SectionHeading.astro'
import Surface from '@/components/ui/Surface.astro'
import Button from '@/components/Button.astro'
import GoogleIcon from '@/icons/google.svg'
import Field from '@/components/ui/Field.astro'
import Notice from '@/components/ui/Notice.astro'
import { CAMPAIGN } from '@/data/campaign'
const user = Astro.locals.user
if (user) return Astro.redirect('/dashboard')
---

<PageLayout
  title="Registro e inicio de sesión | Big Ibai"
  description="Entra o crea tu cuenta en Big Ibai para registrar el código de tu calendario de Adviento y participar en los sorteos de cada casilla."
  participationCount={0}
>
  <div class="login-layout">
    <div class="login-intro">
      <SectionHeading
        as="h1"
        size="page"
        eyebrow="Tu rincón en la fábrica"
        title="La ilusión empieza por aquí."
        description="Inicia sesión para registrar tu calendario, consultar tus participaciones y guardar tus logros."
      />
      <img
        src="/2026/fabrica-small.webp"
        width="600"
        height="788"
        alt="Ibai preparando los regalos en la fábrica"
        class="login-art"
      />
    </div>
    <Surface padded class="login-panel">
      <SectionHeading
        as="h2"
        size="section"
        title="Inicia sesión"
        description={
          CAMPAIGN.emailSignInEnabled
            ? 'Elige cómo quieres entrar en tu cuenta.'
            : 'Entra en tu cuenta con Google.'
        }
      />
      {CAMPAIGN.signInEnabled ? (
      <div id="login-section" class="login-options">
        <form action="/api/auth/signin" method="post" data-astro-reload>
          <input
            type="hidden"
            name="redirect"
            value={Astro.url.searchParams.get('redirect') || '/dashboard'}
          />
          <Button
            id="google-login-btn"
            variant="secondary"
            size="lg"
            class="w-full"
            value="google"
            name="provider"
            type="submit"
          >
            <GoogleIcon />
            Continuar con Google
          </Button>
        </form>
        {CAMPAIGN.emailSignInEnabled && (
        <>
        <div class="ui-divider">o con tu correo</div>
        <form id="magic-link-form" class="space-y-4">
          <Field
            label="Correo electrónico"
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
            inputmode="email"
            placeholder="tu@email.com"
          />
          <div id="turnstile-widget" class="turnstile-widget"></div>
          <Button id="magic-link-btn" type="submit" size="lg" class="w-full">
            <span id="magic-link-text">Enviar enlace de acceso</span>
            <svg
              id="magic-link-spinner"
              class="hidden animate-spin"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="3" opacity=".3" />
              <path d="M12 3a9 9 0 0 1 9 9" stroke="currentColor" stroke-width="3" />
            </svg>
          </Button>
          <p class="login-hint">Te enviaremos un enlace para entrar, sin contraseña.</p>
        </form>
        </>
        )}
        <div id="message" class="ui-notice hidden" role="status" aria-live="polite"></div>
      </div>
      ) : (
        <Notice variant="warning" title="Acceso cerrado temporalmente" class="login-options">
          Estamos preparando la nueva edición. Muy pronto podrás volver a iniciar sesión.
        </Notice>
      )}
      <p class="login-privacy">
        Consulta nuestra <a href="/privacidad">política de privacidad</a> para saber cómo tratamos
        tus datos.
      </p>
    </Surface>
  </div>
</PageLayout>
<style>
  .login-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 80px;
    max-width: 1000px;
    margin-inline: auto;
  }
  .login-intro :global(.ui-description) {
    max-width: 400px;
  }
  .login-art {
    width: 250px;
    height: 220px;
    object-fit: cover;
    object-position: center 54%;
    margin-top: 35px;
    border: 1px solid var(--border-subtle);
    border-radius: 120px 120px var(--radius-panel) var(--radius-panel);
  }
  .login-panel {
    width: 100%;
  }
  .login-panel :global(.ui-heading) {
    font-size: 32px;
  }
  .login-panel :global(.ui-description) {
    font-size: 12px;
  }
  .login-options {
    display: grid;
    gap: 26px;
    margin-top: 28px;
  }
  .login-hint {
    color: var(--text-muted);
    font-size: 10px;
    line-height: 1.8;
    text-align: center;
  }
  .login-privacy {
    margin-top: 28px;
    padding-top: 22px;
    border-top: 1px solid var(--border-subtle);
    color: var(--text-muted);
    font-size: 10px;
    line-height: 1.9;
  }
  .login-privacy a {
    color: var(--brand-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .turnstile-widget {
    display: flex;
    justify-content: center;
  }
  @media (max-width: 900px) {
    .login-layout {
      gap: 40px;
    }
  }
  @media (max-width: 760px) {
    .login-layout {
      grid-template-columns: 1fr;
      gap: 30px;
      max-width: 480px;
    }
    .login-art {
      display: none;
    }
    .login-intro :global(.ui-description) {
      font-size: 12px;
    }
  }
</style>
<script>
  import { actions, isInputError } from 'astro:actions'
  import { showNotice } from '@/components/ui/feedback'
  import { createCaptcha } from '@/utils/turnstile'
  document.addEventListener('astro:page-load', () => {
    const message = document.querySelector<HTMLElement>('#login-section #message')
    if (!message) return
    function showMessage(value: string, isError = false) {
      showNotice(message!, value, isError ? 'error' : 'success')
    }
    const url = new URL(location.href)
    const loginError = url.searchParams.get('error')
    if (loginError) {
      showMessage(
        loginError === 'email_disabled'
          ? 'Por ahora solo se puede entrar con Google.'
          : 'No se ha podido iniciar sesión. Inténtalo de nuevo.',
        true
      )
      url.searchParams.delete('error')
      history.replaceState({}, '', url)
    }
    const form = document.querySelector<HTMLFormElement>('#magic-link-form')
    if (!form || form.dataset.ready) return
    form.dataset.ready = 'true'
    // Supabase Auth valida el token (Bot and Abuse Protection): así tampoco se pueden pedir
    // enlaces directamente a su API saltándose la web
    const captcha = createCaptcha(form.querySelector<HTMLElement>('#turnstile-widget')!)
    const button = form.querySelector<HTMLButtonElement>('#magic-link-btn')!
    const text = form.querySelector<HTMLElement>('#magic-link-text')!
    const spinner = form.querySelector<HTMLElement>('#magic-link-spinner')!
    form.addEventListener('submit', async (event) => {
      event.preventDefault()
      button.disabled = true
      text.textContent = 'Enviando enlace…'
      spinner.classList.remove('hidden')
      message.classList.add('hidden')
      try {
        const email = String(new FormData(form).get('email') || '')
        const captchaToken = await captcha.getToken()
        if (!captchaToken) {
          showMessage(
            'No hemos podido comprobar que no eres un robot. Recarga la página e inténtalo de nuevo.',
            true
          )
          return
        }
        const { data, error } = await actions.sendMagicLink({ email, captchaToken })
        if (error) {
          showMessage(
            isInputError(error)
              ? Object.values(error.fields)[0]?.[0] || 'Revisa tu correo electrónico.'
              : error.code === 'TOO_MANY_REQUESTS' || error.code === 'FORBIDDEN'
                ? error.message
                : 'No se ha podido enviar el enlace. Inténtalo de nuevo más tarde.',
            true
          )
        } else if (data) {
          showMessage(data.message)
          form.reset()
        }
      } catch {
        showMessage(
          'No se ha podido enviar el enlace. Comprueba tu conexión e inténtalo de nuevo.',
          true
        )
      } finally {
        // Cada token sirve una sola vez: se pide otro para el siguiente envío
        captcha.reset()
        button.disabled = false
        text.textContent = 'Enviar enlace de acceso'
        spinner.classList.add('hidden')
      }
    })
  })
</script>
