---
import PageLayout from '@/layouts/PageLayout.astro'
import AccountOverview from '@/components/account/AccountOverview.astro'
import { supabaseAdmin } from '@/supabase-admin'
import { CAMPAIGN } from '@/data/campaign'

const user = Astro.locals.user

if (!user) {
  return Astro.redirect('/registro')
}

// Obtener el número de cupones validados por el usuario y sus logros en paralelo
const [userCouponsResult, achievementsResult] = await Promise.all([
  supabaseAdmin
    .from('coupons')
    .select('id', { count: 'exact', head: true })
    .eq('used_by', user.id)
    .eq('is_used', true),
  supabaseAdmin
    .from('user_achievements')
    .select('achievements')
    .eq('user_id', user.id)
    .maybeSingle(),
])

const totalCoupons = userCouponsResult.count || 0
const userAchievements = achievementsResult.data?.achievements ?? {}
---

<PageLayout title={`Mis participaciones | ${CAMPAIGN.name}`} participationCount={totalCoupons} noindex>
  <AccountOverview totalCoupons={totalCoupons} userAchievements={userAchievements} />
</PageLayout>
